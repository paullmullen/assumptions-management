rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function membershipPath(projectId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId);
    }

    function isActiveMember(projectId) {
      return isVerifiedUser()
        && exists(membershipPath(projectId))
        && get(membershipPath(projectId)).data.userId == request.auth.uid
        && get(membershipPath(projectId)).data.projectId == projectId
        && get(membershipPath(projectId)).data.active == true;
    }

    function hasProjectFields(data) {
      return data.keys().hasOnly(['name', 'description', 'creatorId', 'createdAt'])
        && data.keys().hasAll(['name', 'creatorId', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 1000))
        && data.creatorId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function hasInitialMembershipFields(data, projectId, userId) {
      return data.keys().hasOnly(['projectId', 'userId', 'role', 'active', 'createdAt'])
        && data.keys().hasAll(['projectId', 'userId', 'role', 'active', 'createdAt'])
        && data.projectId == projectId
        && data.userId == userId
        && data.role == 'owner'
        && data.active == true
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;

      match /projectMemberships/{projectId} {
        allow read: if isVerifiedUser() && request.auth.uid == userId;
        allow create: if isVerifiedUser()
          && request.auth.uid == userId
          && !exists(/databases/$(database)/documents/projects/$(projectId))
          && existsAfter(/databases/$(database)/documents/projects/$(projectId))
          && hasInitialMembershipFields(request.resource.data, projectId, userId)
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.creatorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    function hasValidOptionalScore(data, field) {
      return !(field in data)
        || (
          data[field] is int
          && data[field] >= 0
          && data[field] <= 100
        );
    }

    function hasValidAssumptionScores(data) {
      return hasValidOptionalScore(data, 'criticality')
        && hasValidOptionalScore(data, 'evidence');
    }

    match /projects/{projectId} {
      allow create: if isVerifiedUser()
        && hasProjectFields(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId))
        && hasInitialMembershipFields(
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId)).data,
          projectId,
          request.auth.uid
        );
      allow read: if isActiveMember(projectId);
      allow update, delete: if false;

      match /projectBrief/{briefId} {
        allow read: if isActiveMember(projectId);
        allow create, update: if isActiveMember(projectId)
          && briefId == 'overview'
          && request.resource.data.keys().hasOnly([
            'customerPromise',
            'investorPromise',
            'coworkerPromise',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.keys().hasAll([
            'customerPromise',
            'investorPromise',
            'coworkerPromise',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.customerPromise is string
          && request.resource.data.customerPromise.size() <= 4000
          && request.resource.data.investorPromise is string
          && request.resource.data.investorPromise.size() <= 4000
          && request.resource.data.coworkerPromise is string
          && request.resource.data.coworkerPromise.size() <= 4000
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

match /assumptions/{assumptionId} {
  allow read: if isActiveMember(projectId);

  allow create: if isActiveMember(projectId)
    && request.resource.data.keys().hasOnly([
      'statement',
      'criticality',
      'evidence',
      'createdBy',
      'createdAt'
    ])
    && request.resource.data.keys().hasAll([
      'statement',
      'createdBy',
      'createdAt'
    ])
    && request.resource.data.statement is string
    && request.resource.data.statement.size() > 0
    && request.resource.data.statement.size() <= 2000
    && hasValidAssumptionScores(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt is timestamp;

  allow update: if isActiveMember(projectId)
    && request.resource.data.keys().hasOnly([
      'statement',
      'criticality',
      'evidence',
      'createdBy',
      'createdAt',
      'updatedAt',
      'updatedBy'
    ])
    && request.resource.data.keys().hasAll([
      'statement',
      'createdBy',
      'createdAt',
      'updatedAt',
      'updatedBy'
    ])
    && request.resource.data.statement is string
    && request.resource.data.statement.size() > 0
    && request.resource.data.statement.size() <= 2000
    && hasValidAssumptionScores(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt is timestamp
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'statement',
      'criticality',
      'evidence',
      'updatedAt',
      'updatedBy'
    ]);

  allow delete: if false;
}
    }}}