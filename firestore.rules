rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function membershipPath(projectId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId);
    }

    function isActiveMember(projectId) {
      return isVerifiedUser()
        && exists(membershipPath(projectId))
        && get(membershipPath(projectId)).data.userId == request.auth.uid
        && get(membershipPath(projectId)).data.projectId == projectId
        && get(membershipPath(projectId)).data.active == true;
    }

    function isProjectOwner(projectId) {
      return isActiveMember(projectId) && get(membershipPath(projectId)).data.role == 'owner';
    }

    function acceptsInvitation(data, projectId, userId) {
      let invitationPath = /databases/$(database)/documents/projectInvitations/$(data.invitationId);
      let before = get(invitationPath).data;
      let after = getAfter(invitationPath).data;
      return isVerifiedUser() && request.auth.uid == userId
        && data.keys().hasOnly(['projectId', 'userId', 'role', 'active', 'createdAt', 'invitationId', 'email'])
        && data.projectId == projectId && data.userId == userId
        && data.role == 'member' && data.active == true && data.createdAt == request.time
        && data.email == request.auth.token.email.lower()
        && before.projectId == projectId && before.recipientEmail == data.email
        && before.status == 'pending' && before.expiresAt > request.time
        && (!exists(/databases/$(database)/documents/users/$(userId)/projectMemberships/$(projectId))
          || get(/databases/$(database)/documents/users/$(userId)/projectMemberships/$(projectId)).data.active == true
          || before.createdAt > get(/databases/$(database)/documents/users/$(userId)/projectMemberships/$(projectId)).data.removedAt)
        && after.status == 'accepted' && after.acceptedBy == userId && after.acceptedAt == request.time;
    }

    function validRemoval(before, after, projectId, userId) {
      let eventPath = /databases/$(database)/documents/projects/$(projectId)/memberRemovals/$(after.lastRemovalId);
      return isProjectOwner(projectId)
        && before.role == 'member' && before.active == true && after.active == false
        && after.diff(before).affectedKeys().hasOnly(['active', 'removedAt', 'removedBy', 'lastRemovalId'])
        && after.removedAt == request.time && after.removedBy == request.auth.uid
        && !exists(eventPath)
        && getAfter(eventPath).data == {'memberId': userId, 'removedBy': request.auth.uid, 'removedAt': request.time};
    }

    match /projectInvitations/{invitationId} {
      function recipient(data) {
        return isVerifiedUser() && data.recipientEmail == request.auth.token.email.lower();
      }
      function validAcceptance() {
        let data = resource.data;
        let member = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(data.projectId)).data;
        return recipient(data) && data.expiresAt > request.time
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.diff(data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && member.active == true && member.userId == request.auth.uid && member.projectId == data.projectId;
      }
      allow get: if isProjectOwner(resource.data.projectId) || recipient(resource.data);
      allow list: if isProjectOwner(resource.data.projectId);
      allow create: if isProjectOwner(request.resource.data.projectId)
        && request.resource.data.keys().hasOnly(['projectId', 'recipientEmail', 'invitedBy', 'inviterEmail', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.keys().hasAll(['projectId', 'recipientEmail', 'invitedBy', 'inviterEmail', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.recipientEmail is string
        && request.resource.data.recipientEmail.size() <= 254
        && request.resource.data.recipientEmail == request.resource.data.recipientEmail.lower()
        && request.resource.data.recipientEmail.matches('[^\\s@]+@[^\\s@]+[.][^\\s@]+')
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.inviterEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.status == 'pending';
      allow update: if resource.data.status == 'pending' && (
        (isProjectOwner(resource.data.projectId)
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt']))
        || validAcceptance());
      allow delete: if false;
    }

    function hasProjectFields(data) {
      return data.keys().hasOnly(['name', 'description', 'creatorId', 'createdAt', 'formalReviewsEnabled'])
        && data.keys().hasAll(['name', 'creatorId', 'createdAt'])
        && (!('formalReviewsEnabled' in data) || data.formalReviewsEnabled is bool)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 1000))
        && data.creatorId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function hasInitialMembershipFields(data, projectId, userId) {
      return data.keys().hasOnly(['projectId', 'userId', 'role', 'active', 'createdAt'])
        && data.keys().hasAll(['projectId', 'userId', 'role', 'active', 'createdAt'])
        && data.projectId == projectId
        && data.userId == userId
        && data.role == 'owner'
        && data.active == true
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;

      match /projectMemberships/{projectId} {
        allow get: if isVerifiedUser() && (request.auth.uid == userId || isProjectOwner(projectId));
        allow list: if isVerifiedUser() && request.auth.uid == userId;
        allow create: if isVerifiedUser()
          && request.auth.uid == userId
          && !exists(/databases/$(database)/documents/projects/$(projectId))
          && existsAfter(/databases/$(database)/documents/projects/$(projectId))
          && hasInitialMembershipFields(request.resource.data, projectId, userId)
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.creatorId == request.auth.uid;
        allow create: if acceptsInvitation(request.resource.data, projectId, userId)
          && getAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(userId)).data == request.resource.data;
        allow update: if (
          (resource.data.active == false && acceptsInvitation(request.resource.data, projectId, userId))
          || validRemoval(resource.data, request.resource.data, projectId, userId))
          && getAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(userId)).data == request.resource.data;
        allow delete: if false;
      }
    }

    function hasValidOptionalScore(data, field) {
      return !(field in data)
        || (
          data[field] is int
          && data[field] >= 0
          && data[field] <= 100
        );
    }

    function hasValidAssumptionScores(data) {
      return hasValidOptionalScore(data, 'criticality')
        && hasValidOptionalScore(data, 'evidence');
    }

    match /projects/{projectId} {
      allow create: if isVerifiedUser()
        && hasProjectFields(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId))
        && hasInitialMembershipFields(
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId)).data,
          projectId,
          request.auth.uid
        );
      allow read: if isActiveMember(projectId);
      allow update: if isProjectOwner(projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['formalReviewsEnabled', 'reviewPreferenceUpdatedBy', 'reviewPreferenceUpdatedAt'])
        && request.resource.data.formalReviewsEnabled is bool
        && request.resource.data.reviewPreferenceUpdatedBy == request.auth.uid
        && request.resource.data.reviewPreferenceUpdatedAt == request.time;
      allow delete: if false;

      match /members/{userId} {
        allow read: if isProjectOwner(projectId);
        allow create: if acceptsInvitation(request.resource.data, projectId, userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/projectMemberships/$(projectId)).data == request.resource.data;
        allow update: if (
          (resource.data.active == false && acceptsInvitation(request.resource.data, projectId, userId))
          || validRemoval(resource.data, request.resource.data, projectId, userId))
          && getAfter(/databases/$(database)/documents/users/$(userId)/projectMemberships/$(projectId)).data == request.resource.data;
        allow delete: if false;
      }
      match /memberRemovals/{removalId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId)
          && request.resource.data.keys().hasOnly(['memberId', 'removedBy', 'removedAt'])
          && request.resource.data.removedBy == request.auth.uid
          && request.resource.data.removedAt == request.time
          && get(/databases/$(database)/documents/users/$(request.resource.data.memberId)/projectMemberships/$(projectId)).data.active == true
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.memberId)/projectMemberships/$(projectId)).data.active == false
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.memberId)/projectMemberships/$(projectId)).data.lastRemovalId == removalId;
        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if isActiveMember(projectId);
        allow create: if isActiveMember(projectId)
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.get('formalReviewsEnabled', true) == true
          && request.resource.data.keys().hasOnly(['schemaVersion', 'title', 'notes', 'previousReviewId', 'capturedAt', 'assumptions', 'promises', 'publishedBy', 'publisherEmail', 'publishedAt'])
          && request.resource.data.keys().hasAll(['schemaVersion', 'title', 'notes', 'previousReviewId', 'capturedAt', 'assumptions', 'promises', 'publishedBy', 'publisherEmail', 'publishedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.title is string
          && request.resource.data.title.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.title.size() <= 120
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 4000
          && request.resource.data.capturedAt is int
          && request.resource.data.capturedAt > 0
          && request.resource.data.assumptions is list
          && request.resource.data.promises is map
          && request.resource.data.promises.keys().hasOnly(['customerPromise', 'investorPromise', 'coworkerPromise'])
          && request.resource.data.promises.customerPromise is string
          && request.resource.data.promises.investorPromise is string
          && request.resource.data.promises.coworkerPromise is string
          && request.resource.data.publishedBy == request.auth.uid
          && request.resource.data.publisherEmail == request.auth.token.email
          && request.resource.data.publishedAt == request.time
          && (request.resource.data.previousReviewId == null
            || (request.resource.data.previousReviewId is string
              && exists(/databases/$(database)/documents/projects/$(projectId)/reviews/$(request.resource.data.previousReviewId))));
        allow update, delete: if false;
      }

      match /projectBrief/{briefId} {
        allow read: if isActiveMember(projectId);
        allow create, update: if isActiveMember(projectId)
          && briefId == 'overview'
          && request.resource.data.keys().hasOnly([
            'customerPromise',
            'investorPromise',
            'coworkerPromise',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.keys().hasAll([
            'customerPromise',
            'investorPromise',
            'coworkerPromise',
            'updatedAt',
            'updatedBy'
          ])
          && request.resource.data.customerPromise is string
          && request.resource.data.customerPromise.size() <= 4000
          && request.resource.data.investorPromise is string
          && request.resource.data.investorPromise.size() <= 4000
          && request.resource.data.coworkerPromise is string
          && request.resource.data.coworkerPromise.size() <= 4000
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

match /candidates/{candidateId} {
  function validCandidate(data) {
    return data.statement is string && data.statement.matches('[\\s\\S]*[^\\s][\\s\\S]*')
      && data.statement.size() <= 2000;
  }
  function matchingAdoption() {
    let path = /databases/$(database)/documents/projects/$(projectId)/assumptions/$(candidateId);
    let active = getAfter(path).data;
    return !exists(path) && active.sourceCandidateId == candidateId
      && active.lastScoreChangeId == request.resource.data.adoptionInsightId
      && active.criticality is int && active.evidence is int
      && active.statement == resource.data.statement
      && active.createdBy == request.auth.uid && active.createdAt == request.time;
  }
  allow read: if isActiveMember(projectId);
  allow create: if isActiveMember(projectId)
    && request.resource.data.keys().hasOnly(['statement', 'status', 'createdBy', 'authorEmail', 'createdAt'])
    && validCandidate(request.resource.data)
    && request.resource.data.status == 'pending'
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.authorEmail == request.auth.token.email
    && request.resource.data.createdAt == request.time;
  allow update: if isActiveMember(projectId) && resource.data.status == 'pending'
    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statement', 'updatedBy', 'updatedAt'])
      && validCandidate(request.resource.data)
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt == request.time)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adoptedBy', 'adoptedAt', 'adoptionInsightId'])
      && request.resource.data.status == 'adopted'
      && request.resource.data.adoptedBy == request.auth.uid
      && request.resource.data.adoptedAt == request.time
      && matchingAdoption()));
  allow delete: if false;
}

match /assumptions/{assumptionId} {
  function validCandidateOrigin() {
    let path = /databases/$(database)/documents/projects/$(projectId)/candidates/$(assumptionId);
    let before = get(path).data;
    let after = getAfter(path).data;
    return request.resource.data.sourceCandidateId == assumptionId
      && before.status == 'pending' && after.status == 'adopted'
      && after.adoptedBy == request.auth.uid && after.adoptedAt == request.time
      && request.resource.data.statement == before.statement
      && request.resource.data.createdAt == request.time
      && request.resource.data.criticality is int && request.resource.data.evidence is int
      && request.resource.data.lastScoreChangeId == after.adoptionInsightId
      && hasScoreChangeRecord();
  }

  function scorePair(data) {
    return { 'criticality': data.get('criticality', null), 'evidence': data.get('evidence', null) };
  }
  function validScoreChange(data, insightId) {
    let parentPath = /databases/$(database)/documents/projects/$(projectId)/assumptions/$(assumptionId);
    let before = exists(parentPath) ? get(parentPath).data : {};
    let after = getAfter(parentPath).data;
    return data.scoreChange is map
      && data.scoreChange.keys().hasOnly(['from', 'to'])
      && data.scoreChange.keys().hasAll(['from', 'to'])
      && data.scoreChange.from == scorePair(before)
      && data.scoreChange.to == scorePair(after)
      && data.scoreChange.from != data.scoreChange.to
      && after.lastScoreChangeId == insightId
      && after.updatedBy == request.auth.uid
      && after.updatedAt == request.time;
  }
  function hasScoreChangeRecord() {
    let recordId = request.resource.data.lastScoreChangeId;
    let recordPath = /databases/$(database)/documents/projects/$(projectId)/assumptions/$(assumptionId)/insights/$(recordId);
    return recordId is string
      && !exists(recordPath)
      && existsAfter(recordPath)
      && getAfter(recordPath).data.createdBy == request.auth.uid
      && getAfter(recordPath).data.createdAt == request.time
      && getAfter(recordPath).data.scoreChange.from == scorePair(resource == null ? {} : resource.data)
      && getAfter(recordPath).data.scoreChange.to == scorePair(request.resource.data);
  }

  function managementPair(data) {
    return { 'nextStep': data.get('nextStep', ''), 'helpNeeded': data.get('helpNeeded', '') };
  }
  function validManagementChange(data, insightId) {
    let parentPath = /databases/$(database)/documents/projects/$(projectId)/assumptions/$(assumptionId);
    let before = exists(parentPath) ? get(parentPath).data : {};
    let after = getAfter(parentPath).data;
    return data.managementChange is map
      && data.managementChange.keys().hasOnly(['from', 'to'])
      && data.managementChange.keys().hasAll(['from', 'to'])
      && data.managementChange.from == managementPair(before)
      && data.managementChange.to == managementPair(after)
      && data.managementChange.from != data.managementChange.to
      && after.lastManagementChangeId == insightId
      && after.updatedBy == request.auth.uid
      && after.updatedAt == request.time;
  }
  function hasManagementChangeRecord() {
    let recordId = request.resource.data.lastManagementChangeId;
    let recordPath = /databases/$(database)/documents/projects/$(projectId)/assumptions/$(assumptionId)/insights/$(recordId);
    return recordId is string
      && !exists(recordPath)
      && existsAfter(recordPath)
      && getAfter(recordPath).data.createdBy == request.auth.uid
      && getAfter(recordPath).data.createdAt == request.time
      && getAfter(recordPath).data.managementChange.from == managementPair(resource == null ? {} : resource.data)
      && getAfter(recordPath).data.managementChange.to == managementPair(request.resource.data);
  }

  function validManagementFields(data) {
    return (!('nextStep' in data) || (data.nextStep is string && data.nextStep.size() <= 4000))
      && (!('helpNeeded' in data) || (data.helpNeeded is string && data.helpNeeded.size() <= 4000));
  }
  match /insights/{insightId} {
    allow read: if isActiveMember(projectId);
    allow create: if isActiveMember(projectId)
      && existsAfter(/databases/$(database)/documents/projects/$(projectId)/assumptions/$(assumptionId))
      && request.resource.data.keys().hasOnly(['description', 'createdBy', 'authorEmail', 'createdAt', 'sourceUrl', 'classification', 'scoreChange', 'managementChange'])
      && request.resource.data.keys().hasAll(['createdBy', 'authorEmail', 'createdAt'])
      && (('description' in request.resource.data && request.resource.data.description is string
        && request.resource.data.description.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.description.size() <= 4000)
        || (!('description' in request.resource.data) && ('scoreChange' in request.resource.data || 'managementChange' in request.resource.data)))
      && (!('managementChange' in request.resource.data) || validManagementChange(request.resource.data, insightId))
      && (!('scoreChange' in request.resource.data) || validScoreChange(request.resource.data, insightId))
      && (!('sourceUrl' in request.resource.data) && !('classification' in request.resource.data)
        || 'description' in request.resource.data)
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.authorEmail == request.auth.token.email
      && request.resource.data.createdAt == request.time
      && (!('sourceUrl' in request.resource.data) || (
        request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 2000
        && request.resource.data.sourceUrl.matches('https?://[^\\s/?#]+[^\\s]*')
      ))
      && (!('classification' in request.resource.data) || request.resource.data.classification in ['Evidence', 'Revised judgment', 'Mitigation / project change']);
    allow update, delete: if false;
  }

  allow read: if isActiveMember(projectId);

  allow create: if isActiveMember(projectId)
    && request.resource.data.keys().hasOnly([
      'sourceCandidateId',
      'statement',
      'criticality',
      'evidence',
      'createdBy',
      'createdAt', 'nextStep', 'helpNeeded', 'updatedBy', 'updatedAt', 'lastScoreChangeId', 'lastManagementChangeId'
    ])
    && request.resource.data.keys().hasAll([
      'statement',
      'createdBy',
      'createdAt'
    ])
    && request.resource.data.statement is string
    && request.resource.data.statement.size() > 0
    && request.resource.data.statement.size() <= 2000
    && hasValidAssumptionScores(request.resource.data)
    && validManagementFields(request.resource.data)
    && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
    && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
    && (!('lastScoreChangeId' in request.resource.data) || hasScoreChangeRecord())
    && (request.resource.data.get('nextStep', '') != '' || request.resource.data.get('helpNeeded', '') != ''
      ? hasManagementChangeRecord() : !('lastManagementChangeId' in request.resource.data))
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt is timestamp
    && (!('sourceCandidateId' in request.resource.data) || validCandidateOrigin());

  allow update: if isActiveMember(projectId)
    && request.resource.data.keys().hasOnly([
      'sourceCandidateId',
      'statement',
      'criticality',
      'evidence',
      'createdBy',
      'createdAt',
      'updatedAt',
      'updatedBy',
      'lastScoreChangeId',
      'nextStep',
      'helpNeeded',
      'lastManagementChangeId'
    ])
    && request.resource.data.keys().hasAll([
      'statement',
      'createdBy',
      'createdAt',
      'updatedAt',
      'updatedBy'
    ])
    && request.resource.data.statement is string
    && request.resource.data.statement.size() > 0
    && request.resource.data.statement.size() <= 2000
    && hasValidAssumptionScores(request.resource.data)
    && validManagementFields(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt is timestamp
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'statement',
      'criticality',
      'evidence',
      'updatedAt',
      'updatedBy',
      'lastScoreChangeId',
      'nextStep',
      'helpNeeded',
      'lastManagementChangeId'
    ])
    && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['criticality', 'evidence'])
      ? hasScoreChangeRecord()
      : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastScoreChangeId']))
    && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['nextStep', 'helpNeeded'])
      ? hasManagementChangeRecord()
      : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastManagementChangeId']));

  allow delete: if false;
}
    }}}