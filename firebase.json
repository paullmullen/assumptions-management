{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "email-service",
      "codebase": "auth-email",
      "ignore": [
        "node_modules",
        ".git",
        "**/*.test.js",
        ".env*",
        ".secret*",
        "test-*"
      ]
    }
  ]
}
